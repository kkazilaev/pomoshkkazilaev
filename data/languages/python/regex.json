{
  "title": "Регулярные выражения (re)",
  "items": [
    { "code": "re.match(p, s)", "desc": "С начала строки", "detail": "Только если совпадение с начала." },
    { "code": "re.search(p, s)", "desc": "Где угодно", "detail": "Ищет первое совпадение в любом месте." },
    { "code": "re.findall(p, s)", "desc": "Все совпадения", "detail": "Возвращает список." },
    { "code": "re.finditer(p, s)", "desc": "Итератор совпадений", "detail": "Match-объекты." },
    { "code": "re.sub(p, r, s)", "desc": "Замена", "detail": "re.sub(r'\\d+', 'N', 'a1b2') = 'aNbN'." },
    { "code": "re.split(p, s)", "desc": "Разбиение", "detail": "re.split(r'\\s+', 'a b c')." },
    { "code": "re.compile(p)", "desc": "Компиляция", "detail": "Кеширует паттерн для повторного использования." },
    { "code": "re.escape(s)", "desc": "Экранирование", "detail": "Экранирует спецсимволы в строке." },
    { "code": "\\d / \\D", "desc": "Цифра / не цифра", "detail": "\\d = [0-9]." },
    { "code": "\\w / \\W", "desc": "Слово / не слово", "detail": "\\w = [a-zA-Z0-9_]." },
    { "code": "\\s / \\S", "desc": "Пробел / не пробел", "detail": "\\s = [ \\t\\n\\r\\f\\v]." },
    { "code": ".", "desc": "Любой символ", "detail": "Кроме \\n (без re.DOTALL)." },
    { "code": "^ / $", "desc": "Начало / конец", "detail": "^ — начало строки, $ — конец." },
    { "code": "* + ?", "desc": "Кванторы", "detail": "* — 0+, + — 1+, ? — 0 или 1." },
    { "code": "{n, m}", "desc": "Диапазон", "detail": "a{2,4} — от 2 до 4 'a'." },
    { "code": "[]", "desc": "Класс символов", "detail": "[abc] — a, b или c. [^abc] — всё кроме." },
    { "code": "|", "desc": "ИЛИ", "detail": "a|b — 'a' или 'b'." },
    { "code": "()", "desc": "Группа", "detail": "m.group(1) — первая группа." },
    { "code": "(?P<name>...)", "desc": "Именованная группа", "detail": "m.group('name')." },
    { "code": "(?:...)", "desc": "Незахватывающая группа", "detail": "Не попадает в результат." },
    { "code": "(?=...) / (?!...)", "desc": "Lookahead", "detail": "Проверка вперёд без захвата." },
    { "code": "re.IGNORECASE", "desc": "Флаг: без регистра", "detail": "re.I." },
    { "code": "re.MULTILINE", "desc": "Флаг: ^ и $ по строкам", "detail": "re.M." },
    { "code": "re.DOTALL", "desc": "Флаг: . включает \\n", "detail": "re.S." },
    { "code": "re.VERBOSE", "desc": "Флаг: пробелы игнорируются", "detail": "re.X. Для читаемых паттернов." }
  ]
}