{
  "title": "Методы строк (str)",
  "items": [
    { "code": "s.upper() / s.lower()", "desc": "Регистр", "detail": "upper — в верхний, lower — в нижний. casefold — агрессивный нижний." },
    { "code": "s.capitalize()", "desc": "Первый заглавный", "detail": "Первый символ — заглавный, остальные — строчные." },
    { "code": "s.title()", "desc": "Заглавные в словах", "detail": "'hello world'.title() → 'Hello World'." },
    { "code": "s.strip(chars)", "desc": "Обрезка по краям", "detail": "Убирает пробелы. lstrip — слева, rstrip — справа." },
    { "code": "s.split(sep)", "desc": "Разбиение", "detail": "Без sep — по пробелам с удалением пустых." },
    { "code": "s.rsplit(sep, n)", "desc": "Разбиение справа", "detail": "Разбивает с конца, n — максимум разбиений." },
    { "code": "s.splitlines()", "desc": "Разбиение по строкам", "detail": "Разбивает по \\n, \\r, \\r\\n." },
    { "code": "s.join(iter)", "desc": "Объединение", "detail": "Все элементы должны быть строками." },
    { "code": "s.replace(old, new, n)", "desc": "Замена", "detail": "n — сколько раз. Возвращает новую строку." },
