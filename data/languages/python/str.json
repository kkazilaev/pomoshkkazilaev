    { "code": "s.count(sub)", "desc": "Количество", "detail": "'aaa'.count('a') = 3." },
    { "code": "s.startswith(pref)", "desc": "Начинается с", "detail": "Принимает кортеж префиксов." },
    { "code": "s.endswith(suff)", "desc": "Заканчивается на", "detail": "Принимает кортеж суффиксов." },
    { "code": "s.isdigit()", "desc": "Только цифры", "detail": "'123'.isdigit() → True." },
    { "code": "s.isalpha()", "desc": "Только буквы", "detail": "'abc'.isalpha() → True." },
    { "code": "s.isalnum()", "desc": "Буквы и цифры", "detail": "'a1'.isalnum() → True." },
    { "code": "s.isspace()", "desc": "Только пробелы", "detail": "'  \\t'.isspace() → True." },
    { "code": "s.isupper() / s.islower()", "desc": "Регистр строки", "detail": "'ABC'.isupper() → True." },
    { "code": "s.istitle()", "desc": "Заглавные в словах", "detail": "'Hello World'.istitle() → True." },
    { "code": "s.zfill(w)", "desc": "Дополнение нулями", "detail": "'42'.zfill(5) = '00042'." },
    { "code": "s.center(w, c)", "desc": "Центрирование", "detail": "'x'.center(5, '-') = '--x--'." },
    { "code": "s.ljust(w) / s.rjust(w)", "desc": "Выравнивание", "detail": "ljust — по левому, rjust — по правому краю." },
    { "code": "s.format(*a, **kw)", "desc": "Форматирование", "detail": "'{} {}'.format('a', 'b'). Заменено f-строками." },
    { "code": "s.encode(enc)", "desc": "В байты", "detail": "s.encode('utf-8') → bytes." },
    { "code": "s.casefold()", "desc": "Агрессивный нижний", "detail": "Лучше lower() для сравнения без регистра." },
    { "code": "s.removeprefix(p)", "desc": "Удалить префикс", "detail": "3.9+: 'foobar'.removeprefix('foo') = 'bar'." },
    { "code": "s.removesuffix(s)", "desc": "Удалить суффикс", "detail": "3.9+: 'foobar'.removesuffix('bar') = 'foo'." },
    { "code": "s.partition(sep)", "desc": "Разбиение на 3 части", "detail": "Возвращает (до, sep, после)." },
    { "code": "s.expandtabs(n)", "desc": "Замена табов", "detail": "Заменяет \\t на n пробелов." },
    { "code": "s.maketrans() / s.translate()", "desc": "Таблица замен", "detail": "Быстрая замена символов через таблицу." }
  ]
}