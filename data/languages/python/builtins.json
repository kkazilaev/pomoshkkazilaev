    { "code": "hasattr(o, name)", "desc": "Есть атрибут?", "detail": "hasattr('', 'upper') = True." },
    { "code": "getattr(o, name, def)", "desc": "Получить атрибут", "detail": "getattr(obj, 'x') == obj.x. С def — безопасно." },
    { "code": "setattr(o, name, val)", "desc": "Установить атрибут", "detail": "setattr(obj, 'x', 5) == obj.x = 5." }
