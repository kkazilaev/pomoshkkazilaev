    { "code": "abs(x)", "desc": "Модуль", "detail": "Абсолютное значение. Для complex — длина: abs(3+4j) = 5.0." },
    { "code": "round(x, n)", "desc": "Округление", "detail": "До n знаков. Банковское округление: round(0.5) = 0." },
