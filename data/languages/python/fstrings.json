{
  "title": "Форматирование строк",
  "items": [
    { "code": "f\"{x}\"", "desc": "f-строка", "detail": "Подстановка переменных. Самый современный способ." },
    { "code": "f\"{x + y}\"", "desc": "Выражения", "detail": "Можно любые выражения внутри {}." },
    { "code": "f\"{x:.2f}\"", "desc": "Точность", "detail": "3.14159 → '3.14'." },
    { "code": "f\"{x:>10}\"", "desc": "Выравнивание", "detail": "> вправо, < влево, ^ по центру. 10 — ширина." },
    { "code": "f\"{x:,}\"", "desc": "Разделители", "detail": "1000000 → '1,000,000'." },
    { "code": "f\"{x:%}\"", "desc": "Проценты", "detail": "0.25 → '25.000000%'." },
    { "code": "f\"{x!r}\"", "desc": "repr", "detail": "!r — repr, !s — str, !a — ascii." },
    { "code": "f\"{d['key']}\"", "desc": "Ключ словаря", "detail": "Кавычки снаружи, внутри — как обычно." },
    { "code": "f\"{x=}\"", "desc": "Отладка", "detail": "f'{x=}' → 'x=5'. 3.8+." },
    { "code": "f\"{{}}\"", "desc": "Фигурные скобки", "detail": "{{ → {, }} → }." },
    { "code": "f\"{x:0>5}\"", "desc": "Ведущие нули", "detail": "42 → '00042'." },
    { "code": "format(x, spec)", "desc": "Метод format", "detail": "format(3.14, '.1f') = '3.1'." },
    { "code": "\"%s\" % x", "desc": "Старый способ", "detail": "%s — строка, %d — целое, %f — float." },
    { "code": "\"template\".format()", "desc": "Метод format строки", "detail": "'{} {}'.format('a', 'b')." },
    { "code": "Template", "desc": "Безопасные шаблоны", "detail": "string.Template('$x').substitute(x=1)." }
  ]
}