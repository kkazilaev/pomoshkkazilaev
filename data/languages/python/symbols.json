{
  "title": "Символы и синтаксис",
  "items": [
    { "code": "#", "desc": "Комментарий", "detail": "Всё после # игнорируется до конца строки." },
    { "code": "\\n", "desc": "Перенос строки", "detail": "Escape-последовательность. Реальный перенос в выводе." },
    { "code": "\\t", "desc": "Табуляция", "detail": "Горизонтальный отступ. Используется для выравнивания." },
    { "code": "\\r", "desc": "Возврат каретки", "detail": "Курсор в начало строки. Для прогресс-баров." },
    { "code": "\\b", "desc": "Возврат на 1 символ", "detail": "Backspace. Работает не во всех терминалах." },
    { "code": "\\a", "desc": "Звук", "detail": "Звуковой сигнал (BEL). Зависит от системы." },
    { "code": "\\", "desc": "Экранирование", "detail": "\\\\ → \\, \\' → ', \\\" → \". Продолжение строки в конце." },
    { "code": "\\0", "desc": "Нулевой байт", "detail": "Символ NUL. Используется в бинарных данных." },
    { "code": "\\xHH", "desc": "Символ по hex", "detail": "\\x41 = 'A'. Для байтов." },
    { "code": "\\uHHHH", "desc": "Unicode", "detail": "\\u0416 = 'Ж'. Для Unicode-символов." },
    { "code": "\\N{name}", "desc": "Символ по имени", "detail": "\\N{GREEK SMALL LETTER ALPHA} = 'α'." },
    { "code": "()", "desc": "Круглые скобки", "detail": "Группировка, вызов функции, кортеж. (x,) — кортеж из одного." },
    { "code": "[]", "desc": "Квадратные скобки", "detail": "Список, индексация, срезы. lst[1:3], lst[::-1]." },
    { "code": "{}", "desc": "Фигурные скобки", "detail": "Словарь или множество. {} — пустой словарь." },
    { "code": "[:]", "desc": "Срез", "detail": "lst[start:stop:step]. lst[::-1] — реверс." },
    { "code": ":", "desc": "Начало блока", "detail": "После if, for, while, def, class. Обязателен." },
    { "code": ",", "desc": "Разделитель", "detail": "Разделяет аргументы, элементы, ключи." },
    { "code": "->", "desc": "Аннотация возврата", "detail": "def f() -> int: указывает тип возвращаемого значения." },
    { "code": "=>", "desc": "Стрелка в аннотациях", "detail": "В Python нет =>. Используется в lambda: lambda x: x+1." },
    { "code": "...", "desc": "Ellipsis", "detail": "Многоточие. Заглушка или для numpy-индексации." },
    { "code": "->", "desc": "Аннотации типов", "detail": "def f(x: int) -> str: ..." },
    { "code": "@", "desc": "Декоратор", "detail": "@decorator над функцией. Синтаксический сахар для decorator(func)." },
    { "code": "_", "desc": "Подчёркивание", "detail": "Игнорируемая переменная, приватный атрибут, последний результат в REPL." },
    { "code": "__name__", "desc": "Двойные подчёркивания", "detail": "Магические методы/атрибуты: __init__, __str__, __name__." },
    { "code": "if __name__ == \"__main__\":", "desc": "Точка входа", "detail": "Выполняется только при прямом запуске файла, не при импорте." },
    { "code": "\"\"\"", "desc": "Многострочная строка", "detail": "Для docstring и длинных текстов. Сохраняет переносы." }
